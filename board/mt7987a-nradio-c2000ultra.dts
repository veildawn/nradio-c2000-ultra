// SPDX-License-Identifier: (GPL-2.0 OR MIT)
// NRadio C2000 Ultra on official OpenWrt (MT7987A + MT7992 BE5040 + MT5700M-CN).
// Hardware pinout, PCIe Wi-Fi reset, SPI2/SD pinmux, cooling fan power/PWM,
// Ethernet PHYs, and 5G modem GPIOs cross-verified against Factory & Mwrt DTBs.

/dts-v1/;
#include "mt7987a.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "NRadio C2000 Ultra";
	compatible = "nradio,c2000-ultra", "mediatek,mt7987a", "mediatek,mt7987";

	aliases {
		serial0 = &uart0;
		mmc0 = &mmc0;
		led-boot = &led_status;
		led-failsafe = &led_error;
		led-running = &led_status;
		led-upgrade = &led_status;
	};

	chosen {
		bootargs = "console=ttyS0,115200n1 earlycon=uart8250,mmio32,0x11000000 pci=pcie_bus_perf root=PARTLABEL=rootfs rootwait rootfstype=squashfs,f2fs";
		stdout-path = "serial0:115200n8";
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
		};

		wps {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <10>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status: led-status {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};

		led-cmode5 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <0>;
			gpios = <&pio 8 GPIO_ACTIVE_LOW>;
		};

		led-cmode4 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <1>;
			gpios = <&pio 11 GPIO_ACTIVE_LOW>;
		};

		led-internet {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_WAN;
			gpios = <&pio 10 GPIO_ACTIVE_LOW>;
		};

		led_error: led-error {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_FAULT;
			gpios = <&pio 12 GPIO_ACTIVE_LOW>;
		};
	};

	pwm-leds {
		compatible = "pwm-leds";

		led-ambient {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			function-enumerator = <2>;
			pwms = <&pwm 0 50000 0>;
			max-brightness = <255>;
			active-low;
			default-state = "on";
		};
	};

	reg_3p3v: regulator-3p3v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_usb_5v: regulator-usb-5v {
		compatible = "regulator-fixed";
		regulator-name = "usb-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_fan: regulator-fan {
		compatible = "regulator-fixed";
		regulator-name = "fan";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
	};

	gpio_export {
		compatible = "gpio-export";
		#size-cells = <0>;

		cpepower {
			gpio-export,name = "cpe-pwr";
			gpio-export,output = <0>;
			gpios = <&pio 49 GPIO_ACTIVE_LOW>;
		};

		cpesel0 {
			gpio-export,name = "cpe-sel0";
			gpio-export,output = <0>;
			gpios = <&pio 48 GPIO_ACTIVE_HIGH>;
		};
	};
};

&cpu_trip_active_low {
	temperature = <65000>;
	hysteresis = <5000>;
};

&cpu_trip_active_med {
	temperature = <75000>;
	hysteresis = <5000>;
};

&cpu_trip_active_high {
	temperature = <85000>;
	hysteresis = <5000>;
};

&eth {
	status = "okay";
};

&gmac0 {
	phy-mode = "2500base-x";
	phy-handle = <&phy11>;
	status = "okay";
};

&gmac1 {
	phy-mode = "internal";
	phy-handle = <&phy15>;
	status = "okay";
};

&mdio {
	phy15: phy@f {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <15>;
		phy-mode = "internal";
		pinctrl-names = "i2p5gbe-led";
		pinctrl-0 = <&i2p5gbe_led0_pins>;
	};

	phy11: phy@b {
		compatible = "ethernet-phy-id03a2.a411";
		reg = <11>;
		reset-gpios = <&pio 42 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <20000>;
		phy-mode = "2500base-x";
	};
};

&mmc0 {
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&sd_pins_default>;
	pinctrl-1 = <&sd_pins_uhs>;
	bus-width = <4>;
	max-frequency = <50000000>;
	cap-sd-highspeed;
	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&reg_3p3v>;
	non-removable;
	no-mmc;
	no-sdio;
	broken-cd;
	status = "okay";
};

&pcie0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_1_pins>;
	wifi-reset-gpios = <&pio 38 GPIO_ACTIVE_LOW>;
	wifi-reset-msleep = <100>;
	status = "okay";

	pcie@0,0 {
		reg = <0x0000 0 0 0 0>;
		#address-cells = <3>;
		#size-cells = <2>;
		device_type = "pci";

		wifi@0,0 {
			compatible = "mediatek,mt76";
			reg = <0x0000 0 0 0 0>;
			#address-cells = <1>;
			#size-cells = <0>;
			nvmem-cells = <&eeprom_factory_0>;
			nvmem-cell-names = "eeprom";
			ieee80211-freq-limit = <2400000 2500000>,
					       <5170000 5835000>;
		};
	};
};

&pcie1 {
	status = "disabled";
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_c2ku_pins>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "BL2";
				reg = <0x0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x40000 0x10000>;
			};

			partition@50000 {
				label = "Factory";
				reg = <0x50000 0x100000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					eeprom_factory_0: eeprom@0 {
						reg = <0x0 0x1e00>;
					};
				};
			};

			partition@150000 {
				label = "bdinfo";
				reg = <0x150000 0x80000>;
				read-only;
			};

			partition@1d0000 {
				label = "FIP";
				reg = <0x1d0000 0x100000>;
				read-only;
			};

			partition@2d0000 {
				// Keep the vendor image opaque to OpenWrt's MTD splitter.
				// This leaves the TF rootdisk as fstools' rootfs_data.
				label = "factory-firmware";
				reg = <0x2d0000 0x1d30000>;
				read-only;
			};
		};
	};
};

&fan {
	cooling-levels = <0 80 150 255>;
	fan-supply = <&reg_fan>;
	pwms = <&pwm 1 50000 0>;
	status = "okay";
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm_c2ku_pins>;
	status = "okay";
};

&pio {
	pcie0_1_pins: pcie0-pins-g1 {
		mux {
			function = "pcie";
			groups = "pcie0_pereset", "pcie0_clkreq";
		};
	};

	pwm_c2ku_pins: pwm-c2ku-pins {
		mux {
			function = "pwm";
			groups = "pwm0", "pwm1_0";
		};
	};

	spi2_c2ku_pins: spi2-c2ku-pins {
		mux {
			function = "spi";
			groups = "spi2";
		};
	};
};

&ssusb {
	vusb33-supply = <&reg_3p3v>;
	vbus-supply = <&reg_usb_5v>;
	status = "okay";
};

&tphyu3port0 {
	status = "okay";
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};
