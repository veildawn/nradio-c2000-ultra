#!/bin/sh /etc/rc.common

START=98
STOP=12
USE_PROCD=1

start_service() {
	[ "$(board_name)" = "nradio,c2000-ultra" ] || return 0
	[ "$(uci -q get nrapp.global.enabled)" != "0" ] || return 0
	procd_open_instance
	procd_set_param command /bin/sh /usr/sbin/nr-apptrack --daemon
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
