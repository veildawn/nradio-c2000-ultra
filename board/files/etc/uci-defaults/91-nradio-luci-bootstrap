#!/bin/sh

# A preserved LuCI config can still reference the removed theme.
uci -q get luci.main >/dev/null || exit 1

changed=0
if [ "$(uci -q get luci.main.mediaurlbase)" = "/luci-static/astryx" ]; then
	uci set luci.main.mediaurlbase=/luci-static/bootstrap || exit 1
	changed=1
fi
if [ "$(uci -q get luci.themes.Astryx)" = "/luci-static/astryx" ]; then
	uci -q delete luci.themes.Astryx || exit 1
	changed=1
fi
[ "$changed" = 0 ] || uci commit luci || exit 1
exit 0
