{
	"luci-app-nradio-c2000": {
		"description": "Grant access to NRadio C2000 Ultra 5G modem, dual-boot and online upgrade management",
		"read": {
			"file": {
				"/usr/sbin/mt5700-status": [
					"exec"
				],
				"/usr/sbin/nr-app-status": [
					"exec"
				]
			},
			"uci": [
				"mt5700",
				"nrapp"
			]
		},
		"write": {
			"file": {
				"/usr/sbin/c2000-bootswitch": [
					"exec"
				],
				"/usr/sbin/mt5700-status": [
					"exec"
				],
				"/usr/sbin/c2000-upgrade": [
					"exec"
				],
				"/sbin/reboot": [
					"exec"
				],
				"/sbin/sysupgrade": [
					"exec"
				],
				"/usr/sbin/nr-app-status": [
					"exec"
				],
				"/etc/init.d/nr-apptrack": [
					"exec"
				]
			},
			"uci": [
				"mt5700",
				"nrapp"
			]
		}
	}
}
