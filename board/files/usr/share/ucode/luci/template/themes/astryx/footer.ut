		{% if (!blank_page): %}
		</main>
		<footer class="nr-version">NRadio C2000 Ultra <span>·</span> {{ version.distversion ?? 'OpenWrt' }}</footer>
		{% if (ctx.authsession): %}<script>L.require('menu-astryx');</script>{% endif %}
		<script src="{{ resource }}/astryx-frame.js"></script>
		<script type="module">if (window.parent === window) import('{{ media }}/astryx.js');</script>
		{% endif %}
	</body>
</html>
