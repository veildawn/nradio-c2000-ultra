#!/bin/sh
# NRadio C2000 Ultra per-client application tracking & DNS-level blocking
# (luci-app-nradio-c2000 「应用管控」).
#
# Visibility: enables dnsmasq query logging into a RAM file and aggregates
#   per (client, app) query counts / last-seen using the curated domain map
#   /usr/share/nradio-c2000/app-domains.json (suffix match). Unknown domains
#   are kept as a global top-list to help extend the map.
# Blocking:  blocked apps get address=/<domain>/0.0.0.0 rules in a RAM
#   conf-dir include — domain-resolved apps stop working. Hardcoded-IP apps
#   are out of scope for the DNS approach (noted in the UI).
#
# Anti-wear: aggregates live in /tmp/nrapp/state.db and checkpoint to
#   /etc/nrapp/state.db at most every 10 minutes.

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

RUNDIR=/tmp/nrapp
CONFDIR=$RUNDIR/dnsmasq.d
LOG=$RUNDIR/dnsmasq.log
CURSOR=$RUNDIR/cursor
VDB=$RUNDIR/state.db
PDB=/etc/nrapp/state.db
DOMAINS=/usr/share/nradio-c2000/app-domains.json
APP_DOMS=$RUNDIR/appmap.txt
LOG_MAX=262144

log() { logger -t nr-apptrack "$*"; }

# one-time cleanup of the conf-dir experiment (ujail'd dnsmasq cannot read
# files under /tmp; managed uci address lists replaced it)
cleanup_legacy_confdir() {
	if [ "$(uci -q get dhcp.@dnsmasq[0].confdir)" = "$CONFDIR" ]; then
		uci delete dhcp.@dnsmasq[0].confdir
		uci commit dhcp
	fi
	rm -rf "$CONFDIR" 2>/dev/null
}

# ---------- domain map: flat "domain app" lines, rebuilt when json changes ----------
load_domain_map() {
	mkdir -p "$RUNDIR" "$CONFDIR"
	[ -s "$APP_DOMS" ] && [ "$APP_DOMS" -nt "$DOMAINS" ] && return 0
	local raw
	raw=$(cat "$DOMAINS" 2>/dev/null)
	json_load "$raw" || return 1
	json_select apps || { json_cleanup; return 1; }
	local keys key id doms d
	: > "$APP_DOMS.tmp"
	json_get_keys keys
	for key in $keys; do
		json_select "$key" || continue
		json_get_var id id
		if json_select domains 2>/dev/null; then
			json_get_values doms
			for d in $doms; do
				printf '%s %s\n' "$d" "$id" >> "$APP_DOMS.tmp"
			done
			json_select ..
		fi
		json_select ..
	done
	json_cleanup
	mv -f "$APP_DOMS.tmp" "$APP_DOMS"
}

# suffix match: exact domain, or any map entry that is a domain suffix
# ("a.bilibili.com" matches map line "bilibili.com")
match_app() {
	local dom="$1" hit
	hit=$(awk -v d="$dom" '
		$1 == d { print $2; exit }
		# suffix: domain ends in "." $1
		index(d, "." $1) == length(d) - length($1) { print $2; exit }
	' "$APP_DOMS" 2>/dev/null)
	echo "$hit"
}

# ---------- dnsmasq integration ----------
ensure_dnsmasq_config() {
	local dirty=0
	if [ "$(uci -q get nrapp.global.enabled)" != "0" ]; then
		if [ "$(uci -q get dhcp.@dnsmasq[0].logqueries)" != "1" ] ||
		   [ "$(uci -q get dhcp.@dnsmasq[0].logfacility)" != "$LOG" ]; then
			uci set dhcp.@dnsmasq[0].logqueries='1'
			uci set dhcp.@dnsmasq[0].logfacility="$LOG"
			dirty=1
		fi
	else
		if [ -n "$(uci -q get dhcp.@dnsmasq[0].logqueries)" ]; then
			uci delete dhcp.@dnsmasq[0].logqueries
			uci delete dhcp.@dnsmasq[0].logfacility
			dirty=1
		fi
	fi
	if [ "$dirty" = "1" ]; then
		uci commit dhcp
		/etc/init.d/dnsmasq restart
		: > "$CURSOR" 2>/dev/null
		log "dnsmasq logging/confdir updated"
	fi
}

# honor the UI "clear stats" marker
apply_clear_marker() {
	[ "$(uci -q get nrapp.global.clear)" = "1" ] || return 0
	uci -q delete nrapp.global.clear
	uci commit nrapp
	: > "$VDB"
	: > "$RUNDIR/tally.txt" 2>/dev/null
	rm -f "$PDB"
	log "statistics cleared (LuCI)"
}

regen_block_rules() {
	# blocked app ids from uci nrapp
	local blocked_apps="" i app
	i=0
	while uci -q get nrapp.@app[$i] >/dev/null 2>&1; do
		if [ "$(uci -q get nrapp.@app[$i].blocked)" = "1" ]; then
			app=$(uci -q get nrapp.@app[$i].app)
			[ -n "$app" ] && blocked_apps="$blocked_apps $app "
		fi
		i=$((i + 1))
	done

	# managed uci values look like "/domain/0.0.0.0"; dnsmasq init expands
	# them to address=/domain/0.0.0.0 in the generated main config (the
	# ujail'd dnsmasq cannot read conf-dirs under /tmp)
	local want have
	if [ -n "$blocked_apps" ]; then
		want=$(awk -v keep="$blocked_apps" '
			index(" " keep " ", " " $2 " ") > 0 { printf "/%s/\n", $1 }
		' "$APP_DOMS" | sort)
	fi
	have=$(uci -q get dhcp.@dnsmasq[0].address 2>/dev/null | grep '^/' | sort)
	if [ "$want" != "$have" ]; then
		# rebuild the list: keep foreign entries, replace managed "/x/0.0.0.0" ones
		local e foreign=""
		for e in $have; do :; done
		for e in $(uci -q get dhcp.@dnsmasq[0].address 2>/dev/null); do
			case "$e" in
			/*/) ;;
			*) foreign="$foreign $e" ;;
			esac
		done
		# del_list is per-value: delete every current value, keep none
		for e in $(uci -q get dhcp.@dnsmasq[0].address 2>/dev/null); do
			uci del_list "dhcp.@dnsmasq[0].address=$e" 2>/dev/null
		done
		for e in $foreign; do uci add_list dhcp.@dnsmasq[0].address="$e"; done
		printf '%s\n' "$want" | while IFS= read -r e; do
			[ -n "$e" ] && uci add_list dhcp.@dnsmasq[0].address="$e"
		done
		uci commit dhcp
		/etc/init.d/dnsmasq restart
		log "app block rules updated (%d rules)" "$(printf '%s\n' "$want" | grep -c .)"
	fi
}

# ---------- aggregation ----------
aggregate_once() {
	local off size
	[ -f "$LOG" ] || return 0
	size=$(wc -c < "$LOG" | tr -d ' ')
	off=$(cat "$CURSOR" 2>/dev/null | tr -cd '0-9')
	: "${off:=0}"
	if [ "$size" -lt "$off" ]; then
		# log was rotated/truncated under us
		: > "$LOG"; echo 0 > "$CURSOR"; return 0
	fi
	[ "$size" -eq "$off" ] && return 0

	local now
	now=$(date +%s)
	touch "$VDB"
	tail -c +$((off + 1)) "$LOG" | sed -n 's/.*query\[[^]]*\] \([^ ]*\) from \([0-9a-fA-F.:]*\).*/\1 \2/p' | \
	while read -r dom client; do
		app=$(match_app "$dom")
		if [ -n "$app" ]; then
			printf 'c|%s|%s\n' "$client" "$app" >> "$RUNDIR/tally.txt"
		else
			printf 'c|%s|other\n' "$client" >> "$RUNDIR/tally.txt"
			printf 'u|%s\n' "$dom" >> "$RUNDIR/tally.txt"
		fi
	done
	echo "$size" > "$CURSOR"

	# fold tally into the state db
	if [ -s "$RUNDIR/tally.txt" ]; then
		sort "$RUNDIR/tally.txt" | uniq -c | while read -r cnt kv; do
			[ -n "$kv" ] || continue
			cur=$(sed -n "s|^$(printf '%s' "$kv" | sed 's/[.[\*^$]/\\&/g')=\([0-9]*\) .*|\1|p" "$VDB" | tail -n 1)
			: "${cur:=0}"
			printf '%s=%d %d\n' "$kv" $((cur + cnt)) "$now" >> "$VDB.new"
		done
		# merge: new rows replace old keys
		cut -d= -f1 "$VDB.new" 2>/dev/null | sort -u > "$VDB.keys"
		grep -vxF -f "$VDB.keys" "$VDB" 2>/dev/null > "$VDB.merged"
		cat "$VDB.new" >> "$VDB.merged"
		mv -f "$VDB.merged" "$VDB"
		rm -f "$VDB.new" "$VDB.keys" "$RUNDIR/tally.txt"
	fi

	# rotate the query log
	[ "$size" -gt "$LOG_MAX" ] && { : > "$LOG"; echo 0 > "$CURSOR"; }

	# checkpoint at most every 10 minutes
	local ckpt
	ckpt=$(sed -n 's/^ckpt=//p' "$PDB" 2>/dev/null | tr -cd '0-9')
	if [ -z "$ckpt" ] || [ $((now - ckpt)) -ge 600 ]; then
		mkdir -p /etc/nrapp
		{ echo "ckpt=$now"; grep -v '^ckpt=' "$VDB" 2>/dev/null; } > "$PDB"
	fi
}

restore_state() {
	if [ ! -s "$VDB" ] && [ -s "$PDB" ]; then
		grep -v '^ckpt=' "$PDB" > "$VDB"
	fi
}

trim_state() {
	# drop rows idle for 14 days
	local cutoff=$(( $(date +%s) - 1209600 ))
	awk -v c="$cutoff" '$NF >= c' "$VDB" 2>/dev/null > "$VDB.tmp"
	mv -f "$VDB.tmp" "$VDB"
}

case "${1:---once}" in
--once)
	load_domain_map && cleanup_legacy_confdir && ensure_dnsmasq_config && apply_clear_marker && regen_block_rules && restore_state && aggregate_once
	;;
--daemon)
	log "starting"
	trap 'log "stopping"; exit 0' INT TERM
	last_trim=$(date +%s)
	while true; do
		load_domain_map
		cleanup_legacy_confdir
		ensure_dnsmasq_config
		apply_clear_marker
		regen_block_rules
		restore_state
		aggregate_once
		now=$(date +%s)
		if [ $((now - last_trim)) -ge 86400 ]; then
			trim_state
			last_trim=$now
		fi
		sleep 20
	done
	;;
*)
	echo "Usage: $0 {--once|--daemon}" >&2
	exit 1
	;;
esac
