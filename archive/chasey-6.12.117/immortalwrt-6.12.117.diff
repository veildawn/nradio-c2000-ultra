-+static int
-+an8855_nl_prepare_reply(struct genl_info *info, u8 cmd,
-+				   struct sk_buff **skbp)
-+{
-+	struct sk_buff *msg;
-+	void *reply;
-+
-+	if (!info)
-+		return -EINVAL;
-+
-+	msg = genlmsg_new(NLMSG_GOODSIZE, GFP_KERNEL);
-+	if (!msg)
-+		return -ENOMEM;
-+
-+	/* Construct send-back message header */
-+	reply = genlmsg_put(msg, info->snd_portid, info->snd_seq,
-+				&an8855_nl_family, 0, cmd);
-+	if (!reply) {
-+		nlmsg_free(msg);
-+		return -EINVAL;
-+	}
-+
-+	*skbp = msg;
-+	return 0;
-+}
