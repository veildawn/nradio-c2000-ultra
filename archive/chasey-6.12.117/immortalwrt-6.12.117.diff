+ 			|| IS_ENTRY_REPEATER(pEntry)) && pEntry->Sst == SST_ASSOC) {
+ 			struct UNI_EVENT_ONE_STA_RX_MPDU_COUNT_T *prRxMpduCountResult =
+ 				(struct UNI_EVENT_ONE_STA_RX_MPDU_COUNT_T *)&prEventResult->rRxMpduCountResult[Idx];
+-			if (le2cpu32(prRxMpduCountResult->u4RxTotalMpduCount >
